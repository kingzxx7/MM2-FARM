local UI = makeGui()

local function getCoinsFolder()
    local container = Workspace:FindFirstChild("Coins") or Workspace
    local list = {}

    for _, obj in ipairs(container:GetChildren()) do
        if not obj:IsA("BasePart") and not obj:IsA("Model") then continue end

        local nameMatch = false
        for _, n in ipairs(CONFIG.CoinNames) do
            if obj.Name:lower():find(n:lower(), 1, true) then
                nameMatch = true
                break
            end
        end

        if nameMatch or obj:GetAttribute(CONFIG.CoinTag) then
            local part = obj:IsA("BasePart") and obj or obj.PrimaryPart
            if not part and obj:IsA("Model") then
                part = obj:FindFirstChildWhichIsA("BasePart", true)
            end
            if part then
                table.insert(list, {obj = obj, part = part})
            end
        end
    end

    return list
end

local function getNearestCoin()
    local coins = getCoinsFolder()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local nearest, bestDist = nil, math.huge
    for _, c in ipairs(coins) do
        if not c.part.Parent then continue end
        local d = (c.part.Position - hrp.Position).Magnitude
        if d < bestDist then
            bestDist = d
            nearest = c
        end
    end
    return nearest
end

local function moveTo(pos)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum:MoveTo(pos)
end

local function collectCoin(coin)
    if coin and coin.obj and coin.obj.Parent then
        coin.obj:Destroy()
    end
end

local function waitForCharacter()
    if LocalPlayer.Character then return end
    LocalPlayer.CharacterAdded:Wait()
    task.wait(0.5)
end

local function resetCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    end
end

local function runCycle()
    if State.CycleActive then return end
    State.CycleActive = true
    State.CoinCount = 0
    UI.UpdateCounter()
    UI.UpdateStatus("Iniciando ciclo", Color3.fromRGB(180, 220, 255))
    UI.Notify("Novo ciclo iniciado", 2.5)

    while State.AutoFarm and State.Running and State.CoinCount < CONFIG.MaxCoins do
        local coin = getNearestCoin()
        if not coin then
            UI.UpdateStatus("Aguardando moedas...", Color3.fromRGB(255, 200, 100))
            task.wait(CONFIG.ScanInterval)
            continue
        end

        UI.UpdateStatus("Indo até moeda", Color3.fromRGB(150, 200, 255))

        local char = LocalPlayer.Character
        if not char then
            waitForCharacter()
            continue
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.1) continue end

        local targetPos = coin.part.Position
        local t0 = tick()

        while State.AutoFarm and State.Running and tick() - t0 < CONFIG.MoveTimeout do
            if not coin.part or not coin.part.Parent then break end
            local charNow = LocalPlayer.Character
            if not charNow then break end
            local hrpNow = charNow:FindFirstChild("HumanoidRootPart")
            if not hrpNow then break end

            local dist = (coin.part.Position - hrpNow.Position).Magnitude
            if dist <= CONFIG.CollectRadius then
                break
            end

            moveTo(coin.part.Position)
            task.wait(0.08)
        end

        local charNow = LocalPlayer.Character
        local hrpNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
        if coin.part and coin.part.Parent and hrpNow then
            local dist = (coin.part.Position - hrpNow.Position).Magnitude
            if dist <= CONFIG.CollectRadius + 2 then
                collectCoin(coin)
                State.CoinCount = State.CoinCount + 1
                UI.UpdateCounter()
                UI.Notify("Moeda coletada (" .. State.CoinCount .. "/" .. CONFIG.MaxCoins .. ")", 1.6)
            else
                UI.UpdateStatus("Moeda inalcançável, tentando outra", Color3.fromRGB(255, 150, 150))
            end
        end

        task.wait(0.05)
    end

    if State.CoinCount >= CONFIG.MaxCoins then
        UI.UpdateStatus("Meta atingida! Resetando...", Color3.fromRGB(120, 255, 150))
        UI.Notify("40 moedas coletadas! Resetando personagem...", 3)

        task.wait(0.8)
        State.CycleActive = false

        resetCharacter()
        waitForCharacter()

        task.wait(1.5)

        if State.AutoFarm and State.Running then
            UI.Notify("Reiniciando novo ciclo", 2)
            task.spawn(runCycle)
        else
            UI.UpdateStatus("Parado", Color3.fromRGB(160, 160, 180))
        end
    else
        State.CycleActive = false
        UI.UpdateStatus("Farm interrompido", Color3.fromRGB(255, 160, 160))
    end
end

