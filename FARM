-- ===== FUNÇÕES DE APOIO =====
local function notify(t)
    Rayfield:Notify({Title = "MM2 Farm", Content = t, Duration = 2})
end
local function updateUI()
    CoinLabel:Set("Coins: " .. State.CoinCount .. "/" .. MAX_COINS)
end
local function setStatus(t)
    StatusLabel:Set("Status: " .. t)
end

-- ===== ANTI-AFK =====
local vu = game:GetService("VirtualUser")
LP.Idled:Connect(function()
    if not CONFIG.AntiAFK then return end
    vu:CaptureController()
    vu:ClickButton2(Vector2.new())
end)

-- ===== NOCLIP =====
RunService.Stepped:Connect(function()
    if not CONFIG.NoClip then return end
    local char = LP.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            p.CanCollide = false
        end
    end
end)

-- ===== BUSCAR MOEDAS =====
local function getCoins()
    local list = {}
    for _, map in ipairs(Workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            for _, coinModel in ipairs(container:GetChildren()) do
                if coinModel.Name == "Coin_Server" then
                    local visual = coinModel:FindFirstChild("CoinVisual")
                    local part   = visual and visual:FindFirstChild("MainCoin")
                    if part and part:IsA("BasePart") and part.Parent then
                        table.insert(list, {obj = coinModel, part = part})
                    end
                end
            end
        end
    end
    return list
end

local function getNearest()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, c in ipairs(getCoins()) do
        local d = (c.part.Position - hrp.Position).Magnitude
        if d < bd then bd = d best = c end
    end
    return best
end

-- ===== ESPERAR PERSONAGEM PRONTO =====
local function waitForCharacterReady()
    local char = LP.Character
    if not char then
        char = LP.CharacterAdded:Wait()
    end
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        if hum.Health <= 0 then
            LP.CharacterAdded:Wait()
        end
    end
    task.wait(1)
end

-- ===== ESPERAR PARTIDA COMEÇAR =====
local function waitForRound()
    State.Waiting = true
    setStatus("Aguardando partida iniciar...")
    notify("Aguardando nova partida")

    while State.Running do
        -- Personagem vivo E moedas existindo = partida rodando
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local coins = getCoins()
            if #coins > 0 then
                State.Waiting = false
                return true
            end
        end
        task.wait(1)
    end
    State.Waiting = false
    return false
end

local function waitChar()
    if LP.Character then return end
    LP.CharacterAdded:Wait()
    task.wait(0.5)
end

local function resetChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

-- ===== LOOP PRINCIPAL =====
local function cycle()
    if State.Active then return end
    State.Active = true
    State.CoinCount = 0
    updateUI()
    setStatus("Iniciando ciclo")
    notify("Novo ciclo iniciado")

    while State.Running and State.CoinCount < MAX_COINS do
        -- Verifica se personagem morreu no meio
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then
            setStatus("Personagem morreu, aguardando...")
            task.wait(2)
            -- Espera nova partida começar
            if not waitForRound() then break end
            setStatus("Partida iniciada, retomando...")
        end

        local coin = getNearest()
        if not coin then
            setStatus("Aguardando moedas...")
            task.wait(0.5)
        else
            setStatus("Voando até moeda")
            local char = LP.Character
            if not char then
                waitChar()
            else
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    -- Vai direto pra moeda, mantendo a altura atual do HRP
                    local dest = coin.part.Position
                    local t0 = tick()

                    while State.Running and tick() - t0 < 8 do
                        if not coin.part or not coin.part.Parent then break end
                        local cn = LP.Character
                        if not cn then break end
                        local hn = cn:FindFirstChild("HumanoidRootPart")
                        if not hn then break end

                        local current = hn.Position
                        local dir = dest - current
                        local dist = dir.Magnitude

                        if dist <= 3 then break end

                        local step = dir.Unit * math.min(CONFIG.Speed * (1/60), dist)
                        hn.CFrame = CFrame.new(current + step)
                        RunService.RenderStepped:Wait()
                    end

                    local cn = LP.Character
                    local hn = cn and cn:FindFirstChild("HumanoidRootPart")
                    if coin.part and coin.part.Parent and hn then
                        if (coin.part.Position - hn.Position).Magnitude <= COLLECT_RADIUS then
                            State.CoinCount = State.CoinCount + 1
                            updateUI()
                            notify("Moeda " .. State.CoinCount .. "/" .. MAX_COINS)
                            local gone = tick()
                            while coin.part.Parent and tick() - gone < 1.5 do
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end
            task.wait(0.05)
        end
    end

    if State.CoinCount >= MAX_COINS then
        setStatus("Meta atingida! Resetando...")
        notify("40 moedas! Resetando personagem")
        task.wait(0.8)
        State.Active = false
        resetChar()

        -- Espera respawn + nova partida
        task.wait(2)
        if not waitForRound() then
            setStatus("Farm interrompido")
            return
        end

        if State.Running then
            notify("Reiniciando ciclo")
            task.spawn(cycle)
        else
            setStatus("Parado")
        end
    else
        State.Active = false
        setStatus("Farm interrompido")
    end
end

function startFarm()
    if State.Running and State.Active then
        notify("Já está rodando")
        return
    end
    State.Running = true
    notify("Farm iniciado")
    task.spawn(function()
        -- Espera partida ativa antes de começar
        if not waitForRound() then
            setStatus("Farm parado")
            return
        end
        cycle()
    end)
end

function stopFarm()
    State.Running = false
    State.Active = false
    State.Waiting = false
    setStatus("Farm parado")
    notify("Stop Farm")
end

updateUI()
setStatus("Pronto")
notify("MM2 Farm Hub carregado")
