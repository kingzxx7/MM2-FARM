    Range = {30, 400}, Increment = 10, Suffix = "studs/s",
    CurrentValue = CONFIG.Speed, Flag = "FlySpeed",
    Callback = function(v) CONFIG.Speed = v end,
})

Tab:CreateToggle({
    Name = "Atravessar Paredes",
    CurrentValue = true, Flag = "NoClip",
    Callback = function(v) CONFIG.NoClip = v end,
})

Tab:CreateToggle({
    Name = "Anti-AFK",
    CurrentValue = true, Flag = "AntiAFK",
    Callback = function(v) CONFIG.AntiAFK = v end,
})

-- ===== FUNÇÕES =====
local function notify(t)
    Rayfield:Notify({Title = "MM2 Farm", Content = t, Duration = 2})
end
local function updateUI()
    CoinLabel:Set("Coins: " .. State.CoinCount .. "/" .. MAX_COINS)
end
local function setStatus(t)
    StatusLabel:Set("Status: " .. t)
end

-- ===== ANTI-AFK =====
local vu = game:GetService("VirtualUser")
LP.Idled:Connect(function()
    if not CONFIG.AntiAFK then return end
    vu:CaptureController()
    vu:ClickButton2(Vector2.new())
end)

-- ===== NOCLIP =====
RunService.Stepped:Connect(function()
    if not CONFIG.NoClip then return end
    local char = LP.Character
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then
            p.CanCollide = false
        end
    end
end)

-- ===== DETECTAR MORTE =====
LP.CharacterAdded:Connect(function(char)
    State.Dead = false
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum.Died:Connect(function() State.Dead = true end)
    end
end)

if LP.Character then
    local hum = LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.Died:Connect(function() State.Dead = true end) end
end

-- ===== CHECAR SE ESTÁ EM PARTIDA =====
local function isInRound()
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if hrp.Position.Y < -500 then return false end
    if #getCoins() == 0 then return false end
    return true
end

-- ===== BUSCAR MOEDAS =====
function getCoins()
    local list = {}
    for _, map in ipairs(Workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            for _, coinModel in ipairs(container:GetChildren()) do
                if coinModel.Name == "Coin_Server" then
                    local visual = coinModel:FindFirstChild("CoinVisual")
                    local part   = visual and visual:FindFirstChild("MainCoin")
                    if part and part:IsA("BasePart") and part.Parent then
                        table.insert(list, {obj = coinModel, part = part})
                    end
                end
            end
        end
    end
    return list
end

local function getNearest()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, c in ipairs(getCoins()) do
        local d = (c.part.Position - hrp.Position).Magnitude
        if d < bd then bd = d best = c end
    end
    return best
end

-- ===== ESPERAR =====
local function waitForRound()
    setStatus("Aguardando partida...")
    while State.Running do
        if isInRound() then return true end
        task.wait(1)
    end
    return false
end

local function waitCharReady()
    if not LP.Character then LP.CharacterAdded:Wait() end
    local char = LP.Character
    local hum = char and char:WaitForChild("Humanoid", 5)
    if hum then
        while hum.Health <= 0 do task.wait(0.2) end
    end
    task.wait(1)
end

local function resetChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

-- ===== BODY VELOCITY =====
local function getBV(hrp)
    local bv = hrp:FindFirstChild("MM2FlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "MM2FlyBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.P = 5000
        bv.Parent = hrp
    end
    return bv
end

local function removeBV(hrp)
    if not hrp then return end
    local bv = hrp:FindFirstChild("MM2FlyBV")
    if bv then bv:Destroy() end
end

-- ===== VOAR ATÉ POSIÇÃO (uma altura só, sem subir/descer) =====
local function flyTo(targetPos, bv)
    while State.Running and not State.Dead do
        if not isInRound() then return false end
        local cn = LP.Character
        if not cn then return false end
        local hn = cn:FindFirstChild("HumanoidRootPart")
        if not hn then return false end
        if not bv or not bv.Parent then return false end

        local dir = targetPos - hn.Position
        if dir.Magnitude <= 2 then
            bv.Velocity = Vector3.new(0, 0, 0)
            return true
        end

        bv.Velocity = dir.Unit * CONFIG.Speed
        RunService.RenderStepped:Wait()
    end
    return false
end

-- ===== CONTA SÓ SE MOEDA REALMENTE SUMIU =====
local function collectCoin(coin)
    local serverRef = coin.obj
    if not serverRef.Parent then return false end

    local t0 = tick()
    while tick() - t0 < 1.5 do
        if not serverRef.Parent then return true end
        task.wait(0.05)
    end
    return false
end

-- ===== LOOP =====
local function cycle()
    if State.Active then return end
    State.Active = true
    State.CoinCount = 0
    State.Dead = false
    updateUI()
    setStatus("Iniciando ciclo")

    while State.Running and State.CoinCount < MAX_COINS do
        -- Fora de partida? Para e espera
        if not isInRound() then
            local hrp0 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            removeBV(hrp0)
            setStatus("Fora de partida, aguardando...")
            if not waitForRound() then break end
            State.CoinCount = 0
            updateUI()
            setStatus("Partida iniciada")
        end

        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then
            task.wait(0.3)
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.1) continue end

        local coin = getNearest()
        if not coin then
            setStatus("Sem moedas por perto")
            task.wait(0.2)
        else
            setStatus("Voando até moeda")

            local bv = getBV(hrp)
            bv.Velocity = Vector3.new(0, 0, 0)

            local serverRef = coin.obj

            -- Voa direto na moeda (sem subir/descer)
            flyTo(coin.part.Position, bv)

            -- Chegou perto? Só conta se a moeda sumiu
            if not State.Dead and isInRound() then
                local cn = LP.Character
                local hn = cn and cn:FindFirstChild("HumanoidRootPart")
                if hn and serverRef.Parent then
                    if (coin.part.Position - hn.Position).Magnitude <= COLLECT_RADIUS then
                        if collectCoin(coin) then
                            State.CoinCount = State.CoinCount + 1
                            updateUI()
                            notify("Moeda " .. State.CoinCount .. "/" .. MAX_COINS)
                        end
                    end
                end
            end

            removeBV(hrp)
        end
    end

    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    removeBV(hrp)

    if State.CoinCount >= MAX_COINS then
        setStatus("Meta atingida! Resetando...")
        notify("40 moedas! Resetando")
        task.wait(0.5)
        State.Active = false
        resetChar()
        task.wait(2)
        if not waitForRound() then
            setStatus("Farm interrompido")
            return
        end
        if State.Running then
            notify("Reiniciando ciclo")
            task.spawn(cycle)
        else
            setStatus("Parado")
        end
    else
        State.Active = false
        setStatus("Farm interrompido")
    end
end

function startFarm()
    if State.Running and State.Active then
        notify("Já está rodando")
        return
    end
    State.Running = true
    State.Dead = false
    notify("Farm iniciado")
    task.spawn(function()
        waitCharReady()
        if not waitForRound() then
            setStatus("Farm parado")
            return
        end
        cycle()
    end)
end

function stopFarm()
    State.Running = false
    State.Active = false
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    removeBV(hrp)
    setStatus("Farm parado")
    notify("Stop Farm")
end

updateUI()
setStatus("Pronto")
notify("MM2 Farm Hub carregado")