local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LP        = Players.LocalPlayer

local MAX_COINS      = 40
local COLLECT_RADIUS = 8

local CONFIG = {
    Speed        = 120,   -- studs por segundo (voando)
    FlyHeight    = 8,     -- altura que ele voa acima da moeda
    NoClip       = true,
}

local State = { Running = false, CoinCount = 0, Active = false }

-- ===== INTERFACE =====
local Window = Rayfield:CreateWindow({
    Name = "MM2 COIN FARM HUB",
    LoadingTitle = "Carregando...",
    LoadingSubtitle = "farm hub",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local Tab = Window:CreateTab("Farm", 4483362458)

local CoinLabel   = Tab:CreateLabel("Coins: 0/" .. MAX_COINS)
