local function getCoins()
local cont=WS:FindFirstChild("Coins") or WS
local list={}
for _,o in ipairs(cont:GetChildren()) do
if o:IsA("BasePart") or o:IsA("Model") then
local m=false
for _,n in ipairs(CFG.CoinNames) do
if o.Name:lower():find(n:lower(),1,true) then m=true break end end
if m or o:GetAttribute(CFG.CoinTag) then
local p=o:IsA("BasePart") and o or o.PrimaryPart
if not p and o:IsA("Model") then p=o:FindFirstChildWhichIsA("BasePart",true) end
if p then table.insert(list,{obj=o,part=p}) end end end end
return list end

local function nearest()
local c=getCoins() local ch=LP.Character if not ch then return end
local hrp=ch:FindFirstChild("HumanoidRootPart") if not hrp then return end
local best,bd=nil,math.huge
for _,x in ipairs(c) do
if x.part.Parent then
local d=(x.part.Position-hrp.Position).Magnitude
if d<bd then bd=d best=x end end end
return best end

local function move(p) local ch=LP.Character if not ch then return end
local h=ch:FindFirstChildOfClass("Humanoid") if h then h:MoveTo(p) end end

local function collect(c) if c and c.obj and c.obj.Parent then c.obj:Destroy() end end
local function waitChar() if LP.Character then return end LP.CharacterAdded:Wait() task.wait(0.5) end
local function reset() local ch=LP.Character if not ch then return end
local h=ch:FindFirstChildOfClass("Humanoid") if h then h.Health=0 end end

local function cycle()
if State.CycleActive then return end
State.CycleActive=true State.CoinCount=0
updCount() updStat("Iniciando ciclo",Color3.fromRGB(180,220,255))
notify("Novo ciclo iniciado",2.5)
while State.AutoFarm and State.Running and State.CoinCount<CFG.MaxCoins do
local c=nearest()
if not c then updStat("Aguardando moedas...",Color3.fromRGB(255,200,100))
task.wait(CFG.ScanInterval) else
updStat("Indo até moeda",Color3.fromRGB(150,200,255))
local ch=LP.Character
if not ch then waitChar() else
local hrp=ch:FindFirstChild("HumanoidRootPart")
if hrp then
local t0=tick()
while State.AutoFarm and State.Running and tick()-t0<CFG.MoveTimeout do
if not c.part or not c.part.Parent then break end
local cn=LP.Character if not cn then break end
local hn=cn:FindFirstChild("HumanoidRootPart") if not hn then break end
if (c.part.Position-hn.Position).Magnitude<=CFG.CollectRadius then break end
move(c.part.Position) task.wait(0.08) end
local cn=LP.Character local hn=cn and cn:FindFirstChild("HumanoidRootPart")
if c.part and c.part.Parent and hn then
if (c.part.Position-hn.Position).Magnitude<=CFG.CollectRadius+2 then
collect(c) State.CoinCount=State.CoinCount+1 updCount()
notify("Moeda coletada ("..State.CoinCount.."/"..CFG.MaxCoins..")",1.6)
else updStat("Moeda inalcançável",Color3.fromRGB(255,150,150)) end end end end
task.wait(0.05) end end
if State.CoinCount>=CFG.MaxCoins then
updStat("Meta atingida! Resetando...",Color3.fromRGB(120,255,150))
notify("40 moedas! Resetando...",3)
task.wait(0.8) State.CycleActive=false
reset() waitChar() task.wait(1.5)
if State.AutoFarm and State.Running then
notify("Reiniciando ciclo",2) task.spawn(cycle)
else updStat("Parado") end
else State.CycleActive=false updStat("Farm interrompido",Color3.fromRGB(255,160,160)) end end

