-- ===== BUSCAR MOEDAS =====
local function getCoins()
    local list = {}
    local char = LP.Character
    if not char then return list end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return list end

    for _, map in ipairs(Workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            for _, coinModel in ipairs(container:GetChildren()) do
                if coinModel.Name == "Coin_Server" then
                    local visual = coinModel:FindFirstChild("CoinVisual")
                    local part   = visual and visual:FindFirstChild("MainCoin")
                    if part and part:IsA("BasePart") and part.Parent then
                        local diffY = math.abs(part.Position.Y - hrp.Position.Y)
                        if diffY <= MAX_HEIGHT_DIFF then
                            table.insert(list, {obj = coinModel, part = part})
                        end
                    end
                end
            end
        end
    end
    return list
end

local function getNearest()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, c in ipairs(getCoins()) do
        local d = (c.part.Position - hrp.Position).Magnitude
        if d < bd then bd = d best = c end
    end
    return best
end

-- ===== ESPERAR PERSONAGEM / PARTIDA =====
local function waitCharReady()
    if not LP.Character then LP.CharacterAdded:Wait() end
    local char = LP.Character
    local hum = char and char:WaitForChild("Humanoid", 5)
    if hum then
        while hum.Health <= 0 do task.wait(0.2) end
    end
    task.wait(1)
end

local function waitForRound()
    State.Waiting = true
    setStatus("Aguardando partida...")
    while State.Running do
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            if #getCoins() > 0 then
                State.Waiting = false
                return true
            end
        end
        task.wait(1)
    end
    State.Waiting = false
    return false
end

local function resetChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

-- ===== VOO SUAVE (sem TP) =====
local function createFlyController(hrp)
    -- Remove controladores antigos se existirem
    for _, name in ipairs({"MM2FlyBV", "MM2FlyBG"}) do
        local old = hrp:FindFirstChild(name)
        if old then old:Destroy() end
    end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "MM2FlyBV"
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.P = 5000
    bv.Parent = hrp

    return bv
end

local function destroyFlyController(hrp)
    if not hrp then return end
    local bv = hrp:FindFirstChild("MM2FlyBV")
    if bv then bv:Destroy() end
end

-- ===== VOAR ATÉ POSIÇÃO (suave) =====
local function flyTo(targetPos, bv)
    local char = LP.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if not bv or not bv.Parent then return false end

    while State.Running and not State.Dead do
        local cn = LP.Character
        if not cn then return false end
        local hn = cn:FindFirstChild("HumanoidRootPart")
        if not hn then return false end

        local current = hn.Position
        local dir = targetPos - current
        local dist = dir.Magnitude

        if dist <= 3 then
            bv.Velocity = Vector3.new(0, 0, 0)
            return true
        end

        bv.Velocity = dir.Unit * CONFIG.Speed
        RunService.RenderStepped:Wait()
    end
    return false
end

-- ===== LOOP PRINCIPAL =====
local function cycle()
    if State.Active then return end
    State.Active = true
    State.CoinCount = 0
    State.Dead = false
    updateUI()
    setStatus("Iniciando ciclo")
    notify("Novo ciclo iniciado")

    while State.Running and State.CoinCount < MAX_COINS do
        if State.Dead then
            setStatus("Morreu, aguardando...")
            task.wait(2)
            if not waitForRound() then break end
            State.Dead = false
            State.CoinCount = 0
            updateUI()
            setStatus("Nova partida iniciada")
        end

        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then
            State.Dead = true
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.1) continue end

        local coin = getNearest()
        if not coin then
            setStatus("Aguardando moedas...")
            task.wait(0.5)
        else
            setStatus("Voando até moeda")

            -- Cria controlador de voo (uma vez por HRP)
            local bv = hrp:FindFirstChild("MM2FlyBV") or createFlyController(hrp)

            local serverRef = coin.obj
            local dest = coin.part.Position

            local ok = flyTo(dest, bv)

            destroyFlyController(hrp)

            if ok and not State.Dead then
                -- Espera a moeda sumir pra contar
                local gone = tick()
                local disappeared = false
                while tick() - gone < 2 do
                    if not serverRef.Parent then
                        disappeared = true
                        break
                    end
                    task.wait(0.05)
                end

                if disappeared then
                    State.CoinCount = State.CoinCount + 1
                    updateUI()
                    notify("Moeda " .. State.CoinCount .. "/" .. MAX_COINS)
                else
                    setStatus("Moeda não coletada, tentando outra")
                    task.wait(0.2)
                end
            end
            task.wait(0.05)
        end
    end

    -- Garantir que removeu o controlador
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    destroyFlyController(hrp)

    if State.CoinCount >= MAX_COINS then
        setStatus("Meta atingida! Resetando...")
        notify("40 moedas! Resetando personagem")
        task.wait(0.8)
        State.Active = false
        resetChar()
        task.wait(2)
        if not waitForRound() then
            setStatus("Farm interrompido")
            return
        end
        if State.Running then
            notify("Reiniciando ciclo")
            task.spawn(cycle)
        else
            setStatus("Parado")
        end
    else
        State.Active = false
        setStatus("Farm interrompido")
    end
end

function startFarm()
    if State.Running and State.Active then
        notify("Já está rodando")
        return
    end
    State.Running = true
    State.Dead = false
    notify("Farm iniciado")
    task.spawn(function()
        waitCharReady()
        if not waitForRound() then
            setStatus("Farm parado")
            return
        end
        cycle()
    end)
end

function stopFarm()
    State.Running = false
    State.Active = false
    State.Waiting = false
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    destroyFlyController(hrp)
    setStatus("Farm parado")
    notify("Stop Farm")
end

updateUI()
setStatus("Pronto")
notify("MM2 Farm Hub carregado")