local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players    = game:GetService("Players")
local Workspace  = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LP         = Players.LocalPlayer

local MAX_COINS      = 40
local COLLECT_RADIUS = 6

local CONFIG = {
    Speed   = 120,
    NoClip  = true,
    AntiAFK = true,
}

local State = { Running = false, CoinCount = 0, Active = false, Dead = false }

-- ===== INTERFACE =====
local Window = Rayfield:CreateWindow({
    Name = "MM2 COIN FARM HUB",
    LoadingTitle = "Carregando...",
    LoadingSubtitle = "farm hub",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local Tab = Window:CreateTab("Farm", 4483362458)
local CoinLabel   = Tab:CreateLabel("Coins: 0/" .. MAX_COINS)
local StatusLabel = Tab:CreateLabel("Status: Parado")

local AutoToggle
AutoToggle = Tab:CreateToggle({
    Name = "Auto Farm",
    CurrentValue = false,
    Flag = "AutoFarm",
    Callback = function(v) if v then startFarm() else stopFarm() end end,
})

Tab:CreateButton({
    Name = "Stop Farm",
    Callback = function()
        stopFarm()
        if AutoToggle then AutoToggle:Set(false) end
    end,
})

Tab:CreateSection("Movimento")

Tab:CreateSlider({
