-- Carrega a UI do Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LP = Players.LocalPlayer

-- ===== CONFIG =====
local MAX_COINS      = 40
local COLLECT_RADIUS = 6
local MOVE_TIMEOUT   = 6
local SCAN_WAIT      = 0.4
local COIN_NAMES     = {"Coin", "Moeda", "CoinTest"}

-- ===== ESTADO =====
local State = {
    Running   = false,
    CoinCount = 0,
    Active    = false,
}

-- ===== JANELA RAYFIELD =====
local Window = Rayfield:CreateWindow({
    Name = "MM2 COIN FARM HUB",
    LoadingTitle = "Carregando...",
    LoadingSubtitle = "por você",
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

local Tab = Window:CreateTab("Farm", 4483362458)

local CoinLabel = Tab:CreateLabel("Coins: 0/" .. MAX_COINS)
local StatusLabel = Tab:CreateLabel("Status: Parado")

local AutoToggle
AutoToggle = Tab:CreateToggle({
    Name = "Auto Farm",
    CurrentValue = false,
    Flag = "AutoFarm",
    Callback = function(v)
        if v then
            startFarm()
        else
            stopFarm()
        end
    end,
})

Tab:CreateButton({
    Name = "Stop Farm",
    Callback = function()
        stopFarm()
        if AutoToggle then AutoToggle:Set(false) end
    end,
})

-- ===== FUNÇÕES =====
local function notify(t, c)
    Rayfield:Notify({Title = "MM2 Farm", Content = t, Duration = 2})
end

local function updateUI()
    CoinLabel:Set("Coins: " .. State.CoinCount .. "/" .. MAX_COINS)
end

local function setStatus(t)
    StatusLabel:Set("Status: " .. t)
end

local function getCoins()
    local container = Workspace:FindFirstChild("Coins") or Workspace
    local list = {}
    for _, obj in ipairs(container:GetChildren()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local match = false
            for _, n in ipairs(COIN_NAMES) do
                if obj.Name:lower():find(n:lower(), 1, true) then
                    match = true
                    break
                end
            end
            if match then
                local part = obj:IsA("BasePart") and obj or obj.PrimaryPart
                if not part and obj:IsA("Model") then
                    part = obj:FindFirstChildWhichIsA("BasePart", true)
                end
                if part then table.insert(list, {obj = obj, part = part}) end
            end
        end
    end
    return list
end

local function getNearest()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, c in ipairs(getCoins()) do
        if c.part.Parent then
            local d = (c.part.Position - hrp.Position).Magnitude
            if d < bd then bd = d best = c end
        end
    end
    return best
end

local function move(pos)
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum:MoveTo(pos) end
end

local function waitChar()
    if LP.Character then return end
    LP.CharacterAdded:Wait()
    task.wait(0.5)
end

local function resetChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

-- ===== LOOP =====
local function cycle()
    if State.Active then return end
    State.Active = true
    State.CoinCount = 0
    updateUI()
    setStatus("Iniciando ciclo")
    notify("Novo ciclo iniciado")

    while State.Running and State.CoinCount < MAX_COINS do
        local coin = getNearest()
        if not coin then
            setStatus("Aguardando moedas...")
            task.wait(SCAN_WAIT)
        else
            setStatus("Indo até moeda")
            local char = LP.Character
            if not char then waitChar() else
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local t0 = tick()
                    while State.Running and tick() - t0 < MOVE_TIMEOUT do
                        if not coin.part or not coin.part.Parent then break end
                        local cn = LP.Character
                        if not cn then break end
                        local hn = cn:FindFirstChild("HumanoidRootPart")
                        if not hn then break end
                        if (coin.part.Position - hn.Position).Magnitude <= COLLECT_RADIUS then break end
                        move(coin.part.Position)
                        task.wait(0.08)
                    end

                    local cn = LP.Character
                    local hn = cn and cn:FindFirstChild("HumanoidRootPart")
                    if coin.part and coin.part.Parent and hn then
                        if (coin.part.Position - hn.Position).Magnitude <= COLLECT_RADIUS + 2 then
                            coin.obj:Destroy()
                            State.CoinCount = State.CoinCount + 1
                            updateUI()
                            notify("Moeda " .. State.CoinCount .. "/" .. MAX_COINS)
                        end
                    end
                end
            end
            task.wait(0.05)
        end
    end

    if State.CoinCount >= MAX_COINS then
        setStatus("Meta atingida! Resetando...")
        notify("40 moedas! Resetando personagem")
        task.wait(0.8)
        State.Active = false
        resetChar()
        waitChar()
        task.wait(1.5)
        if State.Running then
            notify("Reiniciando ciclo")
            task.spawn(cycle)
        else
            setStatus("Parado")
        end
    else
        State.Active = false
        setStatus("Farm interrompido")
    end
end

function startFarm()
    if State.Running and State.Active then
        notify("Já está rodando")
        return
    end
    State.Running = true
    notify("Farm iniciado")
    task.spawn(cycle)
end

function stopFarm()
    State.Running = false
    State.Active = false
    setStatus("Farm parado")
    notify("Stop Farm")
end

updateUI()
setStatus("Pronto")
notify("MM2 Farm Hub carregado")
