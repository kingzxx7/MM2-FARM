-- ===== BUSCAR MOEDAS =====
local function getCoins()
    local list = {}
    for _, map in ipairs(Workspace:GetChildren()) do
        local container = map:FindFirstChild("CoinContainer")
        if container then
            for _, coinModel in ipairs(container:GetChildren()) do
                if coinModel.Name == "Coin_Server" then
                    local visual = coinModel:FindFirstChild("CoinVisual")
                    local part   = visual and visual:FindFirstChild("MainCoin")
                    if part and part:IsA("BasePart") and part.Parent then
                        table.insert(list, {obj = coinModel, part = part})
                    end
                end
            end
        end
    end
    return list
end

local function getNearest()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, c in ipairs(getCoins()) do
        -- Compara só X e Z (ignora Y porque estamos no subsolo)
        local dx = c.part.Position.X - hrp.Position.X
        local dz = c.part.Position.Z - hrp.Position.Z
        local d = math.sqrt(dx*dx + dz*dz)
        if d < bd then bd = d best = c end
    end
    return best
end

-- ===== ESPERAR PERSONAGEM / PARTIDA =====
local function waitCharReady()
    if not LP.Character then LP.CharacterAdded:Wait() end
    local char = LP.Character
    local hum = char and char:WaitForChild("Humanoid", 5)
    if hum then
        while hum.Health <= 0 do task.wait(0.2) end
    end
    task.wait(1)
end

local function waitForRound()
    State.Waiting = true
    setStatus("Aguardando partida...")
    while State.Running do
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            if #getCoins() > 0 then
                State.Waiting = false
                return true
            end
        end
        task.wait(1)
    end
    State.Waiting = false
    return false
end

local function resetChar()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
end

-- ===== CONTROLE DE VOO =====
local function getOrCreateBV(hrp)
    local bv = hrp:FindFirstChild("MM2FlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "MM2FlyBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.P = 5000
        bv.Parent = hrp
    end
    return bv
end

local function destroyBV(hrp)
    if not hrp then return end
    local bv = hrp:FindFirstChild("MM2FlyBV")
    if bv then bv:Destroy() end
end

-- ===== VOAR SUAVE ATÉ DESTINO =====
local function flyTo(targetPos, bv)
    while State.Running and not State.Dead do
        local cn = LP.Character
        if not cn then return false end
        local hn = cn:FindFirstChild("HumanoidRootPart")
        if not hn then return false end
        if not bv or not bv.Parent then return false end

        local current = hn.Position
        local dir = targetPos - current
        local dist = dir.Magnitude

        if dist <= 3 then
            bv.Velocity = Vector3.new(0, 0, 0)
            return true
        end

        bv.Velocity = dir.Unit * CONFIG.Speed
        RunService.RenderStepped:Wait()
    end
    return false
end

-- ===== PEGAR ALTURA DO CHÃO (raycast) =====
local function getGroundY(x, z)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }

    local origin = Vector3.new(x, 500, z)
    local result = Workspace:Raycast(origin, Vector3.new(0, -1000, 0), params)
    if result then
        return result.Position.Y
    end
    return 0
end

-- ===== LOOP PRINCIPAL =====
local function cycle()
    if State.Active then return end
    State.Active = true
    State.CoinCount = 0
    State.Dead = false
    updateUI()
    setStatus("Iniciando ciclo")
    notify("Novo ciclo iniciado")

    while State.Running and State.CoinCount < MAX_COINS do
        if State.Dead then
            setStatus("Morreu, aguardando...")
            task.wait(2)
            if not waitForRound() then break end
            State.Dead = false
            State.CoinCount = 0
            updateUI()
            setStatus("Nova partida iniciada")
        end

        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum or hum.Health <= 0 then
            State.Dead = true
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.1) continue end

        -- Garante velocidade zero entre moedas
        local bv = getOrCreateBV(hrp)
        bv.Velocity = Vector3.new(0, 0, 0)

        local coin = getNearest()
        if not coin then
            setStatus("Aguardando moedas...")
            task.wait(0.3)
        else
            setStatus("Voando até moeda")

            local coinPos = coin.part.Position

            -- Calcula destino: se undermap ativo, vai pra baixo do chão
            local dest
            if CONFIG.Undermap then
                local groundY = getGroundY(coinPos.X, coinPos.Z)
                dest = Vector3.new(coinPos.X, groundY - CONFIG.UnderDepth, coinPos.Z)
            else
                dest = coinPos
            end

            local serverRef = coin.obj
            local oldCount = State.CoinCount

            flyTo(dest, bv)

            -- Chegou embaixo da moeda? Sobe só pra coletar
            if not State.Dead and CONFIG.Undermap then
                local cn = LP.Character
                local hn = cn and cn:FindFirstChild("HumanoidRootPart")
                if hn and coin.part and coin.part.Parent then
                    -- Teleporte direto na moeda (só o toque final)
                    hn.CFrame = CFrame.new(coinPos + Vector3.new(0, 3, 0))
                    task.wait(0.1)
                end
            end

            -- Conta se realmente sumiu (rápido, sem esperar 2s)
            local gone = tick()
            while tick() - gone < 1 do
                if not serverRef.Parent then break end
                task.wait(0.03)
            end

            if not serverRef.Parent or State.CoinCount == oldCount then
                State.CoinCount = State.CoinCount + 1
                updateUI()
                notify("Moeda " .. State.CoinCount .. "/" .. MAX_COINS)
            end

            -- Volta pro subsolo IMEDIATAMENTE
            if not State.Dead and CONFIG.Undermap then
                local cn = LP.Character
                local hn = cn and cn:FindFirstChild("HumanoidRootPart")
                if hn then
                    local groundY = getGroundY(hn.Position.X, hn.Position.Z)
                    hn.CFrame = CFrame.new(hn.Position.X, groundY - CONFIG.UnderDepth, hn.Position.Z)
                end
            end

            destroyBV(hrp)
        end
    end

    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    destroyBV(hrp)

    if State.CoinCount >= MAX_COINS then
        setStatus("Meta atingida! Resetando...")
        notify("40 moedas! Resetando personagem")
        task.wait(0.8)
        State.Active = false
        resetChar()
        task.wait(2)
        if not waitForRound() then
            setStatus("Farm interrompido")
            return
        end
        if State.Running then
            notify("Reiniciando ciclo")
            task.spawn(cycle)
        else
            setStatus("Parado")
        end
    else
        State.Active = false
        setStatus("Farm interrompido")
    end
end

function startFarm()
    if State.Running and State.Active then
        notify("Já está rodando")
        return
    end
    State.Running = true
    State.Dead = false
    notify("Farm iniciado")
    task.spawn(function()
        waitCharReady()
        if not waitForRound() then
            setStatus("Farm parado")
            return
        end
        cycle()
    end)
end

function stopFarm()
    State.Running = false
    State.Active = false
    State.Waiting = false
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    destroyBV(hrp)
    setStatus("Farm parado")
    notify("Stop Farm")
end

